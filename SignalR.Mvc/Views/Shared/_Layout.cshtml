@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@inject IConfiguration Configuration
@{
    var tokens = Antiforgery.GetAndStoreTokens(Context);
    var roleList = (Context.Session.GetString(SessionKeys.Roles) ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries);
    var displayName = Context.Session.GetString(SessionKeys.DisplayName);
    var accessToken = Context.Session.GetString(SessionKeys.Token);
    var isRequester = roleList.Contains(SessionKeys.Requester);
    var isApprover = roleList.Contains(SessionKeys.Approver);
    var signalRPage = ViewData["SignalRPage"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@tokens.RequestToken" />
    <title>@ViewData["Title"] - Approval sample</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SignalR.Mvc.styles.css" asp-append-version="true" />
</head>
<body data-access-token="@accessToken"
      data-hub-url="@Configuration["Api:HubUrl"]"
      data-page="@signalRPage"
      data-decide-url="@Url.Action("Decide", "Approvals")"
      data-alerts-url="@(isApprover ? Url.Action("Alerts", "Approvals") : "")">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Approvals</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (isRequester)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Approvals" asp-action="Mine">My requests</a>
                            </li>
                        }
                        @if (isApprover)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Approvals" asp-action="Inbox">Inbox</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (displayName is null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Sign in</a>
                            </li>
                        }
                        else
                        {
                            @if (isApprover)
                            {
                                <li class="nav-item dropdown">
                                    <button class="btn btn-link nav-link text-dark alert-bell position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Pending approvals">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                            <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2m.995-14.901a1 1 0 1 0-1.99 0A5 5 0 0 0 3 6c0 1.098-.5 6-2 7h14c-1.5-1-2-5.902-2-7 0-2.42-1.72-4.44-4.005-4.901" />
                                        </svg>
                                        <span id="alert-count" class="position-absolute badge rounded-pill bg-danger d-none">0</span>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end alert-menu p-0" id="alert-menu">
                                        <div id="alert-items"></div>
                                        <div id="alert-empty" class="dropdown-item-text text-muted">No pending requests.</div>
                                        <div class="dropdown-divider m-0"></div>
                                        <a class="dropdown-item" asp-controller="Approvals" asp-action="Inbox">Open inbox</a>
                                    </div>
                                </li>
                            }
                            <li class="nav-item d-flex align-items-center text-muted me-2">@displayName</li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link text-dark">Sign out</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger">@error</div>
            }
            @if (TempData["Message"] is string message)
            {
                <div class="alert alert-success">@message</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Approval sample
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (accessToken is not null)
    {
        <script src="~/lib/signalr/signalr.min.js"></script>
        <script src="~/js/approvals.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
